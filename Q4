#include <stdio.h>

int main() {
    int bookCode, originalCode, remainder;
    int reversedCode = 0;

    printf("Enter the library book code: ");
    scanf("%d", &bookCode);

    originalCode = bookCode;

    while (bookCode > 0) {
        remainder = bookCode % 10;
        reversedCode = (reversedCode * 10) + remainder;
        bookCode = bookCode / 10;
    }

 
    if (originalCode == reversedCode) {
        printf("The book code %d is a valid palindrome.\n", originalCode);
    } else {
        printf("The book code %d is NOT a valid palindrome.\n", originalCode);
    }

    return 0;
}
